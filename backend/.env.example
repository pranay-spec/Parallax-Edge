# Parallax Edge Environment Variables Template
# Copy this file to .env and fill in your keys (optional for basic features)

# Multi-Modal & AI Keys (Optional - has built-in heuristic fallbacks)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Notification Credentials (Optional - for real SMS / WhatsApp delivery)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=whatsapp:+17372212163
